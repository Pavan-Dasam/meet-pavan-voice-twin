# Anthropic Claude Configuration
# Obtain your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Admin Security
# Change this secret key to protect knowledge base mutation endpoints
ADMIN_API_KEY=pavan-admin-secret-key-2026

# RAG & Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=120
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TOP_K=4
MIN_SIMILARITY_SCORE=0.25
MAX_COSINE_DISTANCE=0.75

# Storage Paths
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
UPLOADS_DIRECTORY=./data/uploads
